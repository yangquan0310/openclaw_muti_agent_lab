# 默认排除所有文件
/*

# 但保留 git-secrets 配置
!.gitallowed

# 排除敏感文件
.env
*.key
*.secret
*.pem
*.env*
credentials.json
credentials/
tokens.json
qqbot/data/credential-backup-*.json

# 排除备份文件
*.bak
*.backup
*.old
*.tmp
*.tmp.md
*.backup.*
*.bak.*

# 排除临时文件夹
*/temp/
*/tmp/
temp/
tmp/

# 排除测试文件
*test_*.json
*test_*.md

# 排除日志和缓存文件
*.log
*.cache
*.tmp
*.temp
*.swp
*.swo
*~
.DS_Store

# 排除OpenClaw内部文件
.openclaw
node_modules/
.cache/
*.db
sessions/
devices/
openclaw-*/
subagents/
exec-approvals.json
identity/
venv/
*/venv/
*/sessions/
*.db-journal
*.pyc
__pycache__/
.pytest_cache/
**/.openclaw/
**/*.state.json
**/openclaw-workspace-state.json

# 排除IDE配置文件
.vscode/
.idea/

# 排除数据库
*.db-shm
*.db-wal
*.sqlite-shm
*.sqlite-wal
*.sqlite-shm.shadow
*.sqlite-wal.shadow
*.sqlite.shadow
/state/openclaw.sqlite

# ============================================
# 允许需要备份的文件
# ============================================
!/README.md
!/requirements.txt
!/.gitignore
/openclaw.json
!/workspace/
!/skills/

# openclaw.json 不进版本库（机器相关：端口、API key、allowedOrigins 各机器不同）
# 上面 /* 默认排除，这里注释一下说明意图

# ============================================
# State 目录 
# ============================================
!/state/.gitkeep

# ============================================
# Workspace 目录 - 只追踪实验室7个代理
# ============================================
!/workspace/
/workspace/*/.openclaw/
/workspace/*/temp/
/workspace/*/.env
/workspace/*/memory/dreaming/
/workspace/*/memory/.dreams/session-corpus/
/workspace/*/skills/.skills_store_lock.json
/plugins/workboard/

# ============================================
# Skills 目录（全局共享技能）
# ============================================
# 排除所有，只允许自研核心技能
!skills/
/skills/*
!/skills/.gitignore
!/skills/.skills_store_lock.json
!/skills/research-assistant/
!/skills/research-assistant/**/
!/skills/research-assistant/**
!/skills/skill-developer/
!/skills/skill-developer/**/
!/skills/skill-developer/**
/skills/**/__pycache__/
/skills/**/*.pyc
/skills/**/*.pyo
/skills/**/*.cache
/skills/**/node_modules/
