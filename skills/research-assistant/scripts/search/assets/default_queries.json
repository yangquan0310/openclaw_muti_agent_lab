{
  "_schema": "检索条件文件 | 多主题多轮次检索",
  "_说明": {
    "格式": "JSON，键为主题名，值为条件字典列表（每项一轮检索）",
    "topic": "该检索归属的主题",
    "source": "使用的检索器（cn=CNKI，en=Semantic Scholar），留空则两者都检索",
    "query": "检索关键词（必填）",
    "limit": "最大结果数（默认 20）",
    "year": "年份范围，格式为 'yyyy-yyyy'，仅英文检索器支持",
    "minCitationCount": "最小引用量（客户端过滤，仅英文检索器支持）"
  },
  "_示例": {
