{
  "llm": {
    "default_provider": "deepseek",
    "providers": {
      "deepseek": {
        "name": "deepseek",
        "base_url": "https://api.deepseek.com/v1",
        "default_model": "deepseek-chat",
        "api_key_env": "DEEPSEEK_API_KEY",
        "api_key": "",
        "timeout": 30,
        "temperature": 0.3,
        "max_tokens": 5000
      }
    }
  },
  "semantic_scholar": {
    "api_key_env": "SEMANTIC_SCHOLAR_API_KEY",
    "request_interval": 0.5,
    "default_limit": 20
  },
  "storage": {
    "root_path": "/root/lab_repo/",
    "knowledge_base_dir": "knowledge/",
    "knowledge_base_file": "index.json",
    "notes_dir": "knowledge/note/",
    "notes_file_format": "{note}.md",
    "reviews_dir": "knowledge/review/",
    "reviews_file_format": "{topic}:{type}.md",
    "retrieval_report_dir": "knowledge/retrieval_report/",
    "retrieval_report_file_format": "{topic}.md",
    "search_queries_dir": "knowledge/search_queries/",
    "search_queries_file_format": "{query}.json",
    "topic_dir": "knowledge/topic/",
    "topic_file_format": "{topic}.json"
  }
}
