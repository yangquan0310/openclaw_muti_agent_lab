% APA 第七版参考文献模板
% 使用方式：在 Quarto .md 的 YAML 头里指定 `bibliography: reference.bib`（详见 typesetting.md）

% 期刊文章
@article{Author2024,
  author = {Author, A. B. and Coauthor, C. D.},
  title = {Title of the article},
  journal = {Journal Name},
  year = {2024},
  volume = {1},
  issue = {1},
  pages = {1--10},
  doi = {10.xxxx/xxxxx}
}

% 书籍
@book{Author2023,
  author = {Author, A. B.},
  title = {Title of the book},
  publisher = {Publisher Name},
  address = {City, Country},
  year = {2023}
}

% 会议论文
@inproceedings{Author2024b,
  author = {Author, A. B.},
  title = {Title of the paper},
  booktitle = {Proceedings of the Conference Name},
  year = {2024},
  pages = {1--10},
  address = {City, Country}
}
