    "memory:memory/.dreams/session-corpus/2026-05-11.txt:3:3": {
      "key": "memory:memory/.dreams/session-corpus/2026-05-11.txt:3:3",
      "path": "memory/.dreams/session-corpus/2026-05-11.txt",
      "startLine": 3,
      "endLine": 3,
      "source": "memory",
      "snippet": "User: @大管家 这里是教研室，团队包括了@教员 @呈现师 @心理学家。大管家和心理学家身兼两职，大管家不光要管理实验室的日常事务，还要管理教研室的日常事务。心理学家发挥自己专家的身份，为教育活动提供专业的、前沿的学术视野。教员要负责教学内容提供、知识架构、学科素材。呈现师负责课件制作、排版优化、可视化输出。督导要负责质量审核、标准检查、终审把关。 [System: This message @mentions the following users: 大管家 (open_id: ou_85914e0fb7dea2619160758c6dcea1ea",
      "recallCount": 0,
      "dailyCount": 1,
      "groundedCount": 0,
      "totalScore": 0.58,
